{
  "manifest_version": 3,
  "name": "ATBridge Fab Companion (Preview)",
  "version": "0.2.0",
  "minimum_chrome_version": "102",
  "description": "Pair a running Blender session with your Fab browser tab. No cookie export.",
  "permissions": [
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.fab.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Open ATBridge Companion"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
